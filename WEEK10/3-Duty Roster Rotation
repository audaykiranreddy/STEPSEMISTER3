import java.util.Arrays;

public class DutyRoster {

    public static String[] rotateRoster(String[] names, int k) {
        int n = names.length;
        
        // Handle edge case for empty array
        if (n == 0) {
            return names;
        }

        // Use modulo to eliminate redundant full rotations
        k = k % n;

        // Create a new array to hold the rotated result
        String[] rotated = new String[n];

        // Move each name to its new calculated position
        for (int i = 0; i < n; i++) {
            int newIndex = (i + k) % n;
            rotated[newIndex] = names[i];
        }

        return rotated;
    }

    public static void main(String[] args) {
        // Sample 1 Test
        String[] names1 = {"A", "B", "C", "D", "E"};
        int k1 = 2;
        System.out.println("Sample 1 Output: " + Arrays.toString(rotateRoster(names1, k1)));

        // Sample 2 Test
        String[] names2 = {"A", "B", "C", "D", "E"};
        int k2 = 7;
        System.out.println("Sample 2 Output: " + Arrays.toString(rotateRoster(names2, k2)));
    }
}