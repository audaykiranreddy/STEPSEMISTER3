import java.util.*;

abstract class Appliance {
    protected double hours;

    protected static final double COST_PER_UNIT = 8.0;

    Appliance(double hours) {
        this.hours = hours;
    }

    protected abstract double getPower();

    public double calculateUnits() {
        return (getPower() * hours) / 1000.0;
    }

    public double calculateCost() {
        return calculateUnits() * COST_PER_UNIT;
    }

    public abstract String getType();
}

interface SaverMode {
    default double applySaver(double units) {
        return units * 0.75;
    }
}

class Fridge extends Appliance {
    Fridge(double hours) {
        super(hours);
    }

    protected double getPower() {
        return 150.0;
    }

    public String getType() {
        return "FRIDGE";
    }
}

class AC extends Appliance implements SaverMode {
    AC(double hours) {
        super(hours);
    }

    protected double getPower() {
        return 1500.0;
    }

    public String getType() {
        return "AC";
    }
}

class TV extends Appliance {
    TV(double hours) {
        super(hours);
    }

    protected double getPower() {
        return 100.0;
    }

    public String getType() {
        return "TV";
    }
}

class Washer extends Appliance implements SaverMode {
    Washer(double hours) {
        super(hours);
    }

    protected double getPower() {
        return 500.0;
    }

    public String getType() {
        return "WASHER";
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        double totalCost = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            double hours = sc.nextDouble();

            String mode = "";

            if (sc.hasNext()) {
                mode = sc.nextLine().trim();
            }

            Appliance appliance;

            switch (type) {
                case "FRIDGE":
                    appliance = new Fridge(hours);
                    break;

                case "AC":
                    appliance = new AC(hours);
                    break;

                case "TV":
                    appliance = new TV(hours);
                    break;

                default:
                    appliance = new Washer(hours);
            }

            boolean saverRequested = mode.equals("SAVER");

            if (saverRequested && !(appliance instanceof SaverMode)) {
                System.out.println(
                        appliance.getType()
                                + ": saver mode not supported"
                );
                continue;
            }

            double units = appliance.calculateUnits();

            if (saverRequested) {
                SaverMode saverAppliance =
                        (SaverMode) appliance;

                units = saverAppliance.applySaver(units);
            }

            double cost = units * 8;

            totalCost += cost;

            System.out.printf(
                    "%s: Units=%.2f Cost=%.2f%n",
                    appliance.getType(),
                    units,
                    cost
            );
        }

        System.out.printf(
                "Total Cost: %.2f%n",
                totalCost
        );
    }
}